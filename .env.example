# SafePath-AI Environment Configuration
PROJECT_NAME="SafePath-AI"
VERSION="1.0.0"
API_PREFIX="/api/v1"
DEBUG=True
EXECUTION_MODE="DEMO" # Options: DEMO, RESEARCH, LIVE

# OpenStreetMap Overpass & Open-Meteo Endpoints (Used in LIVE mode)
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Third-Party Map & Geospatial API Keys (Optional - Free OSM & CartoDB are used by default)
MAPBOX_API_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""
OPENROUTESERVICE_API_KEY=""
GOOGLE_MAPS_API_KEY=""
OPENWEATHER_API_KEY=""
